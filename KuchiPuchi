<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Memories 💖</title>

<style>
body {
    margin:0;
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(to bottom right,#ffd6ec,#ffe6f7);
}

/* Title */
h1 {
    text-align:center;
    color:#ff3399;
    margin:20px;
}

/* Month Section */
.month {
    background: rgba(255,255,255,0.6);
    margin:20px;
    padding:20px;
    border-radius:25px;
    box-shadow:0 8px 20px rgba(0,0,0,0.2);
}

.month h2 {
    text-align:center;
    color:#ff4da6;
}

/* Memory Box */
.memory {
    background:white;
    padding:15px;
    border-radius:15px;
    margin:15px auto;
    width:80%;
    text-align:center;
    box-shadow:0 5px 10px rgba(0,0,0,0.1);
}

/* Masonry Gallery */
.gallery {
    column-count:3;
    column-gap:10px;
}

.gallery img {
    width:100%;
    margin-bottom:10px;
    border-radius:15px;
    transition:0.3s;
}

.gallery img:hover {
    transform: scale(1.05);
}

/* Music Button */
.music-btn {
    display:block;
    margin:20px auto;
    padding:10px 20px;
    background:#ff4da6;
    color:white;
    border:none;
    border-radius:20px;
    font-size:16px;
    cursor:pointer;
}

/* Floating Hearts */
.heart {
    position:fixed;
    bottom:-10px;
    font-size:20px;
    animation: float 6s linear infinite;
}

@keyframes float {
    0% {transform:translateY(0);}
    100% {transform:translateY(-100vh);}
}

/* Responsive */
@media(max-width:800px){
    .gallery { column-count:2; }
}
@media(max-width:500px){
    .gallery { column-count:1; }
}
</style>
</head>

<body>

<h1>Our Memories 💖</h1>

<!-- MUSIC BUTTON -->
<button class="music-btn" onclick="playMusic()">🎵 Play Our Song</button>

<audio id="music" loop>
  <source src="song.mp3" type="audio/mpeg">
</audio>

<!-- MONTH EXAMPLE -->
<div class="month">
<h2>April 2025 🌸</h2>

<div class="memory">
Write your beautiful memories of this month here 💕  
(Trips, moments, feelings, everything special)
</div>

<div class="gallery">
<img src="2025-04/photo1.jpg">
<img src="2025-04/photo2.jpg">
<img src="2025-04/photo3.jpg">
<img src="2025-04/photo4.jpg">
<img src="2025-04/photo5.jpg">
</div>

</div>

<div class="month">
<h2>May 2025 🌼</h2>

<div class="memory">
Write what made this month special 💖
</div>

<div class="gallery">
<img src="2025-05/photo1.jpg">
<img src="2025-05/photo2.jpg">
<img src="2025-05/photo3.jpg">
</div>

</div>

<!-- HEART ANIMATION -->
<script>
function playMusic(){
    document.getElementById("music").play();
}

setInterval(function(){
    let heart=document.createElement("div");
    heart.className="heart";
    heart.innerHTML="❤️";
    heart.style.left=Math.random()*100+"vw";
    document.body.appendChild(heart);
    setTimeout(()=>heart.remove(),6000);
},500);
</script>

</body>
</html>
